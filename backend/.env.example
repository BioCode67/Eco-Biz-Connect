# Eco-Biz Connect 백엔드 환경변수 예시.
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env 는 절대 커밋하지 않는다.
# (Render 배포 시에는 render.yaml + 대시보드에서 환경변수를 설정한다. DEPLOYMENT.md 참고.)

# 데이터베이스
#  - 로컬: docker-compose 의 PostgreSQL
#  - Render: 대시보드가 자동 주입(postgres:// 스킴은 코드에서 postgresql:// 로 자동 정규화)
DATABASE_URL=postgresql+psycopg2://ebc:ebc@localhost:5432/ebc

# JWT 인증 (운영에서는 길고 무작위인 시크릿 사용 — Render 는 generateValue 로 자동 생성)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS
#  - BACKEND_CORS_ORIGINS: 허용할 정확한 오리진(콤마 구분). 예) https://eco-biz-connect.vercel.app
#  - BACKEND_CORS_ORIGIN_REGEX: 정규식으로 일괄 허용(선택). 예) https://.*\.vercel\.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
BACKEND_CORS_ORIGIN_REGEX=

# docker-compose 의 PostgreSQL 컨테이너가 참조하는 값(로컬 전용)
POSTGRES_USER=ebc
POSTGRES_PASSWORD=ebc
POSTGRES_DB=ebc
