# Eco-Biz Connect 백엔드 환경변수 예시.
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env 는 절대 커밋하지 않는다.

# 데이터베이스 (docker-compose 의 PostgreSQL 과 동일하게 맞춘다)
DATABASE_URL=postgresql+psycopg2://ebc:ebc@localhost:5432/ebc

# JWT 인증
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS (콤마로 구분, 개발용 localhost 오리진)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# docker-compose 의 PostgreSQL 컨테이너가 참조하는 값
POSTGRES_USER=ebc
POSTGRES_PASSWORD=ebc
POSTGRES_DB=ebc
