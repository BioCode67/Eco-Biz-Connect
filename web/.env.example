# Eco-Biz Connect 웹(Next.js) 환경변수 예시.
# 로컬: 이 파일을 복사해 .env.local 로 만든다.
# Vercel: 프로젝트 Settings → Environment Variables 에서 동일 키를 등록한다. DEPLOYMENT.md 참고.

# 백엔드 API 주소 (NEXT_PUBLIC_ 접두어라 브라우저에 노출됨 — 공개 가능한 값만)
#  - 로컬:  http://localhost:8000
#  - 운영:  https://ebc-backend.onrender.com  (Render 백엔드 URL, 끝에 슬래시 없이)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 사이트 공개 주소 — 링크 미리보기(OG) 이미지의 절대 URL 생성에 사용.
#  - 로컬:  http://localhost:3000
#  - 운영:  https://eco-biz-connect.vercel.app  (Vercel 배포 URL, 끝에 슬래시 없이)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
